<resources>

    <!-- Base application theme. -->
    <!-- Activity themes -->

    <style name="Theme.Base" parent="android:Theme.Light" />

    <style name="Theme.Sample" parent="Theme.Base" />

    <!--
      DayNight, not Light: values-night/colors.xml already flips the custom tokens by resource
      qualifier whatever the theme is, so under a Light theme the screens that only use theme
      defaults (the connect-with-* fragments) ended up with black text on a dark window at night.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryWhite</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="BrandedSwitch.control" parent="Theme.AppCompat.DayNight">
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <style name="BrandedEditText.control" parent="Theme.AppCompat.DayNight">
        <item name="colorControlActivated">@color/colorPrimary</item>

    </style>

    <style name="BrandedSpinner.control" parent="Theme.AppCompat.DayNight">
        <item name="colorControlActivated">@color/colorPrimary</item>

    </style>

    <style name="Widget" />


    <style name="Widget.SampleMessage">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Widget.SampleMessageTile">
        <item name="android:background">@drawable/tile</item>
        <item name="android:shadowColor">#7F000000</item>
        <item name="android:shadowDy">-3.5</item>
        <item name="android:shadowRadius">2</item>
    </style>


    <!--
      Bottom nav items. Hand-rolled rather than a Material BottomNavigationView: AppTheme inherits
      from Theme.AppCompat, and BottomNavigationView refuses to inflate outside a MaterialComponents
      theme. Each item is one TextView with a compound drawable rather than an icon plus a label,
      so a single setSelected() switches the icon tint and the text colour together, both off
      @color/bottom_nav_item.
    -->
    <style name="BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="drawableTint">@color/bottom_nav_item</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bottom_nav_item</item>
    </style>

    <style name="TooltipStyle">
        <item name="android:textColor">?android:textColorPrimaryInverse</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="backgroundColor">@color/colorPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:padding">10dp</item>

    </style>

    <!--
      Coach mark for the "Initialize SDK" button. Wider and denser than TooltipStyle
      because it carries a method signature, and colour-tokenised so it follows dark mode.
    -->
    <style name="CoachMarkTooltipStyle" parent="TooltipStyle">
        <item name="android:textColor">@color/button_text_color</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:maxWidth">300dp</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundColor">@color/buttonColor</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Connection screen: section heading ("PRIMARY ACTIONS") and the SDK call caption under each action. -->
    <style name="ActionSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/hint_font_color</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ActionCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">@font/mono_regular</item>
        <item name="android:textColor">@color/hint_font_color</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Caption under the secondary actions, which sit a third of the width apart. -->
    <style name="ActionCaption.Small">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Centred text, since a long label ("Connection over Connection") wraps onto a second line. -->
    <style name="ActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/title_font_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      Large primary-row button. Sized for half the width of a 320dp phone: a minimum rather than a
      fixed height and slim side padding, so "Disconnect" stays on one line and a larger system font
      grows the button instead of clipping it. textAllCaps off because AppCompat buttons shout.
    -->
    <style name="ActionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      Icon-only secondary button; the icon is set on each ImageButton via android:src. 48dp for the
      touch target with a 32dp visible shape; the negative bottom margin keeps the label as close
      as it was.
    -->
    <style name="SecondaryActionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">-8dp</item>
        <item name="android:background">@drawable/bg_outlined_button_touch</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="LogFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_log_filter_chip_touch</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/log_filter_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Connection Features / Split Tunneling: section heading above each card. -->
    <style name="FeatureSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/hanken_grotesk_regular</item>
        <item name="android:textColor">@color/title_font_color</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bordered card holding a group of feature rows. -->
    <style name="FeatureCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_info_container</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SplitModeOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/title_font_color</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
