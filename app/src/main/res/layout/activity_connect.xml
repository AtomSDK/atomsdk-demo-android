<?xml version="1.0" encoding="utf-8"?>
<!--
  The connect screens draw their own header and send their logs to LogStore (the SDK Logs screen),
  so the activity only adds the bottom nav under them. ConnectActivity wires the nav.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/connect_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
