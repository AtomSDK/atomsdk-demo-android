<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:elevation="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Opens SDK Logs. 40dp touch target; the padding keeps the 24dp icon where it was. -->
        <ImageView
            android:id="@+id/btnSdkLogs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/terminal_icon"
            android:contentDescription="@string/sdk_logs" />

        <include layout="@layout/view_theme_toggle" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/hanken_grotesk_regular"
            android:text="@string/atom_vpn_sdk"
            android:textColor="@color/buttonColor"
            android:textSize="18sp"
            android:textStyle="bold" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_with_dedicated_ip"
                    android:fontFamily="@font/hanken_grotesk_regular"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/title_font_color"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_container"
                android:orientation="vertical">

                <include layout="@layout/view_connect_state" />

                <!-- Dedicated IP or host name, plus the protocol it is dialled with. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dedicated_host"
                        android:textColor="@color/hint_font_color"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etDedicatedIP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autofillHints="none"
                        android:background="@drawable/bg_main_bordered_container"
                        android:fontFamily="@font/mono_regular"
                        android:hint="@string/dedicated_host_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLines="1"
                        android:minHeight="36dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/title_font_color"
                        android:textColorHint="@color/hint_font_color"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/protocol"
                        android:textColor="@color/hint_font_color"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp" />

                    <!-- Read-only: the demo dials dedicated hosts over IKEv2 only. -->
                    <LinearLayout
                        android:id="@+id/dedicatedProtocolChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_main_bordered_container">

                        <TextView
                            android:id="@+id/tvDedicatedProtocol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            android:text="@string/ikev2"
                            android:textColor="@color/title_font_color"
                            android:fontFamily="@font/mono_regular"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <include layout="@layout/view_connect_actions" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
